# AI CHAT (OpenRouter) — optional, only needed for the AI chat assistant feature
OPENROUTER_API_KEY=...

# DOCKER / ADAPTER-NODE
# Host port exposed by Docker Compose.
PACKPAL_PORT=3000

# The public-facing origin of your app (used for CSRF protection).
# Local dev: http://localhost:3000. Behind Tailscale Serve:
# https://<TS_HOSTNAME>.<tailnet>.ts.net
ORIGIN=http://localhost:3000

# SQLite database path (relative to project root; default: data/packpal.db)
# DATABASE_PATH=data/packpal.db

# PRODUCTION (docker/compose.production.yaml)
# Pinned image reference. Always pin a release tag or digest.
# PACKPAL_IMAGE=ghcr.io/<you>/packpal:0.1.0
# PACKPAL_ORIGIN=http://localhost:3000

# TAILSCALE (docker/compose.tailscale.yaml)
# Auth key from the Tailscale admin console (reusable or ephemeral, no funnel).
# TS_AUTHKEY=tskey-auth-...
# Short hostname on the tailnet; app is served at https://<host>.<tailnet>.ts.net
# TS_HOSTNAME=packpal
