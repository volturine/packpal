{
	"name": "packpal",
	"version": "0.0.1",
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261028.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-cloudflare": "^8.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.3",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"wrangler": "^4.154.0"
	},
	"dependencies": {
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"stripe": "^23.0.1"
	},
	"engines": {
		"node": ">=24"
	},
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "playwright test",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:ui": "playwright test --ui",
		"validate": "npm run lint && npm run check && npm run test:unit && npm run build && npm run build:cloudflare",
		"build:cloudflare": "DEPLOY_TARGET=cloudflare vite build",
		"cf:dev": "npm run build:cloudflare && wrangler d1 migrations apply PACKPAL_DB --local --env '' && wrangler dev --env ''",
		"cf:deploy": "npm run build:cloudflare && wrangler d1 migrations apply PACKPAL_DB --remote --env '' && wrangler deploy --env ''",
		"cf:deploy:dev": "npm run build:cloudflare && python3 scripts/reset_cloudflare_dev.py && wrangler d1 migrations apply PACKPAL_DB --remote --env dev && wrangler deploy --env dev"
	},
	"type": "module",
	"overrides": {
		"postcss-selector-parser": "^7.1.6"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
